# 실제 DB·ML·계약서 분석 연동이 기본값입니다.
APP_DATA_MODE=real
# 기능별로 독립 전환할 수 있습니다. 생략하면 APP_DATA_MODE=real을 따릅니다.
COMPANY_DATA_MODE=real
CONTRACT_DATA_MODE=real

# 실제 모드에서는 읽기 전용 PostgreSQL 계정만 사용합니다.
# 권장: 읽기 전용 연결 문자열을 직접 지정합니다. 비밀값은 커밋하지 않습니다.
BOT_DATABASE_URL=
# 파일에서 읽는 방식도 지원합니다. 경로는 각자 환경에 맞게 지정하세요.
# 배포 unit은 이 변수를 /dev/null로 고정하므로 운영에서는 사용하지 않습니다.
# DATABASE_ENV_FILE=
DATABASE_URL=
DB_SSL=false

# 내부 서비스 주소입니다. 브라우저는 이 주소를 직접 호출하지 않습니다.
RAG_API_URL=http://127.0.0.1:5051
RAG_TIMEOUT_MS=20000
CONTRACT_ANALYSIS_URL=http://127.0.0.1:8000
# 문서 인식과 조항 추출에는 수 분이 걸릴 수 있습니다. 최대 300000ms까지 허용합니다.
CONTRACT_TIMEOUT_MS=240000

# 명시적으로 mock 모드를 선택한 개발 환경에서만 적용되는 UI 지연 시간입니다.
MOCK_DELAY_MS=250

# 시스템 프롬프트 파일 위치입니다. 비워 두면 실행 디렉터리의 prompts/ 를 씁니다.
# 프롬프트를 고치면 서버 재시작 없이 반영됩니다. prompts/README.md 를 참고하세요.
PROMPT_DIR=

# 상담은 실제 DB 컨텍스트와 RAG 근거를 두 실제 LLM API에 동일하게 전달합니다.
# 기본값 dual_api는 기존 Upstage/SKT 비교 흐름을 그대로 유지합니다.
# 새 도구 실행 흐름은 openai_responses로 명시했을 때만 활성화됩니다.
CHAT_EXECUTION_MODE=dual_api
# API 키는 환경변수로 직접 넣는 것을 권장합니다(UPSTAGE_API_KEY / SKT_API_KEY).
# 파일에서 읽으려면 경로를 각자 환경에 맞게 지정하세요.
# 배포 unit은 이 변수를 /dev/null로 고정하므로 운영에서는 사용하지 않습니다.
# SHARED_API_KEY_FILE=
UPSTAGE_API_URL=https://api.upstage.ai/v1/chat/completions
UPSTAGE_MODEL=solar-pro3
SKT_API_URL=https://awf-gw.adot.ai/v1/chat/completions
SKT_MODEL=A.X-K1
LLM_TIMEOUT_MS=45000
# 상태 API가 실제 최소 호출로 키 만료·차단 여부를 확인할 때의 제한 시간입니다.
LLM_HEALTH_TIMEOUT_MS=8000

# CHAT_EXECUTION_MODE=openai_responses일 때만 필수입니다.
# 키는 이 예제 파일에 쓰지 말고 OPENAI_API_KEY 환경변수 또는 SHARED_API_KEY_FILE에 둡니다.
OPENAI_API_KEY=
OPENAI_RESPONSES_MODEL=
OPENAI_RESPONSES_API_URL=https://api.openai.com/v1/responses
OPENAI_RESPONSES_TIMEOUT_MS=60000
OPENAI_RESPONSES_RUN_TIMEOUT_MS=420000
OPENAI_RESPONSES_MAX_OUTPUT_TOKENS=900
OPENAI_RESPONSES_MAX_TOOL_ROUNDS=4
OPENAI_RESPONSES_MAX_TOOL_CALLS=8
# 기본 false. stateless reasoning loop에 필요한 encrypted reasoning content만 왕복합니다.
OPENAI_RESPONSES_STORE=false

# 질문·답변 원문은 저장하지 않고 선택 결과와 성능 지표만 저장합니다.
SAVE_COMPARISON_FEEDBACK=true
