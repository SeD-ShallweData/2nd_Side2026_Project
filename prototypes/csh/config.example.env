# 개인 설정 오버라이드 예시입니다.
# 이 파일을 config.env 로 복사해 쓰세요. API 키는 여기 적지 않습니다.
#   cp config.example.env config.env
#
# 키는 팀 공용 원본(/data/shared-SeD/api_key.env)을 코드가 직접 읽습니다.

# 기본 프로바이더: upstage | skt
DEFAULT_PROVIDER=upstage

# 모델 교체
# UPSTAGE_MODEL=solar-pro3
# SKT_MODEL=A.X-K1

# 생성 파라미터
TEMPERATURE=0.0   # 상담 서비스라 0 권장. 표현 다양성을 볼 때만 올리세요
MAX_TOKENS=2048
MAX_HISTORY_TURNS=12

# 서버
PORT=8000
DEBUG=1

# 대화 로그 저장 (outputs/chat_logs/). 끄려면 0
SAVE_CHAT_LOG=1

# 출력 가드레일
#   block — 위반 시 답변을 대체 문구로 교체 (실서비스 동작, 기본값)
#   warn  — 원문을 그대로 두고 무엇에 걸렸는지만 표시
#           프롬프트를 고쳐가며 답변을 확인해야 하는 개발 단계에 씁니다.
GUARDRAIL_MODE=block
# 아예 끄려면 (검사도 안 함)
# GUARDRAILS_ENABLED=0
