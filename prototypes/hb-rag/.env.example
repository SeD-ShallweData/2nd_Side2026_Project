# 이 파일을 .env 로 복사해서 각자 환경에 맞게 채우세요. (.env 는 gitignore 됩니다)
# 탐색 순서: 환경변수 > DONWORRY_ENV_FILE 로 지정한 파일 > 상위 디렉터리의 .env / api_key.env

# Upstage(solar-pro3) API 키 - 필수
Upstage_API_KEY=up_xxxxxxxxxxxxxxxxxxxxxxxx

# 법령 벡터DB(Chroma) 경로 - 미설정 시 개발 서버 기본값
#   /data/shared-SeD/hb/persona_test/labor_law_db
DONWORRY_DB_PATH=/data/shared-SeD/hb/persona_test/labor_law_db

# Chroma 컬렉션 이름 - 미설정 시 labor_law
# DONWORRY_COLLECTION=labor_law
