{
  "name": "wageguard-db",
  "version": "0.1.0",
  "private": true,
  "description": "돈워리 데이터베이스 — 스키마·마이그레이션·ML export 적재",
  "type": "module",
  "scripts": {
    "up": "docker compose --env-file .env.local up -d",
    "down": "docker compose --env-file .env.local down",
    "psql": "docker compose --env-file .env.local exec db psql -U $npm_config_user",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "check:migration-drift": "node scripts/check-migration-drift.mjs",
    "bootstrap:path-b": "./scripts/path-b-trusted-entry.sh bootstrap",
    "release:path-b:export": "./scripts/path-b-trusted-entry.sh export",
    "release:path-b:verify-restore": "./scripts/path-b-trusted-entry.sh restore",
    "studio": "drizzle-kit studio",
    "ingest": "bash scripts/ingest.sh",
    "ingest:industrial-safety": "bash scripts/ingest-industrial-safety.sh",
    "test:industrial-safety-loader": "${INDUSTRIAL_SAFETY_PYTHON:?INDUSTRIAL_SAFETY_PYTHON을 지정하세요} -m unittest tests/test_industrial_safety_loader.py",
    "test:ingest-cli": "node --test tests/ingest-cli.test.mjs tests/ingest-industrial-safety-cli.test.mjs",
    "test:migration-drift": "node --test tests/migration-drift.test.mjs",
    "test:path-b-static": "node --test tests/path-b-bootstrap-static.test.mjs tests/path-b-canonical-timestamp-static.test.mjs tests/path-b-release-gate-static.test.mjs tests/path-b-sql-semantic-static.test.mjs",
    "test:path-b-pg16-semantic": "bash tests/path-b-sql-semantic-gate.pg16.sh",
    "test:path-b-pg16-canonical": "bash tests/path-b-canonical-timestamp.pg16.sh"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
