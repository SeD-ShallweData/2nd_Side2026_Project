# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local 은 커밋되지 않는다.
#   cp .env.example .env.local

# 이 서버는 여러 사람이 함께 쓴다. Docker 컨테이너·볼륨·포트는 머신 전역이므로
# 접두사와 포트를 사람마다 다르게 잡아야 충돌하지 않는다.
COMPOSE_PROJECT_NAME=wageguard-<본인>
DB_HOST=127.0.0.1
DB_PORT=5433

DB_NAME=wageguard
DB_USER=wageguard
DB_PASSWORD=
PGSSLMODE=disable

# GCP VM에서는 별도 Persistent Disk의 디렉터리를 지정한다.
# 로컬에서 비워 두면 Docker named volume pgdata를 사용한다.
POSTGRES_DATA_DIR=

# 위 값과 어긋나지 않게 맞춘다
DATABASE_URL=postgresql://wageguard:<DB_PASSWORD>@127.0.0.1:5433/wageguard

# 챗봇·LLM 에이전트용 읽기 전용 롤 (scripts/create-bot-role.sh)
BOT_USER=wg_bot
BOT_PASSWORD=
